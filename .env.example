# Research gateway
TV_WEBHOOK_TOKEN=replace-with-long-random-token
JEV_WEBHOOK_TOKEN=replace-with-separate-long-random-token
DB_PATH=/data/trading.db
PRIMARY_VENUE=auto
ENRICH_TIMEOUT_S=3.0
SNAPSHOT_MAX_AGE_MS=5000

# Streamer
STREAM_VENUES=binance,hyperliquid
STREAM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SNAPSHOT_INTERVAL_MS=1000
TRADE_WINDOW_MS=30000
CONTEXT_REFRESH_MS=30000

# Current venue endpoints. Keep configurable because venues migrate endpoints.
BINANCE_REST=https://fapi.binance.com
BINANCE_WS=wss://fstream.binance.com/public/ws
HYPERLIQUID_INFO=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS=wss://api.hyperliquid.xyz/ws

# Shadow only. No live order router exists in this repo.
SHADOW_AUTO_ARM=false
SHADOW_REQUIRE_JEV=true
SHADOW_MIN_SCORE=78
SHADOW_MIN_RR=6
JEV_MIN_DIRECTION_PROBABILITY=0.65
JEV_MIN_SETUP_PROBABILITY=0.65
